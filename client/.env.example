# AI assistant — server-only keys (never exposed to the browser).
# Any OpenAI-compatible provider works: Groq (default), OpenRouter, ...
# Copy to .env.local (gitignored) and fill in your key.

AI_API_KEY=
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=llama-3.3-70b-versatile
# OpenRouter example:
#   AI_BASE_URL=https://openrouter.ai/api/v1
#   AI_MODEL=meta-llama/llama-3.3-70b-instruct:free
