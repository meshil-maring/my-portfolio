# Server-side secrets — NEVER commit a filled .env, and never expose any of
# these to the client bundle (same rule as client/src/lib/env.ts).
#
# Copy to .env and fill in. Only LLM_API_KEY is strictly required for chat;
# everything else degrades gracefully (see docs/backend/01-architecture.md).

# --- App -------------------------------------------------------------------
# Comma-separated browser origins allowed by CORS (direct browser→FastAPI mode).
CORS_ORIGINS=http://localhost:3000
# Shared secret for POST /api/admin/ingest (X-Ingest-Token header). Leave empty
# to disable ingestion entirely.
INGEST_TOKEN=

# --- Database (PostgreSQL / Supabase, pgvector required) -------------------
# Supabase: use the Session/pooler connection string; postgres:// is auto-normalized.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/portfolio

# --- Chat LLM (OpenAI-compatible API) ---------------------------------------
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
LLM_MAX_TOKENS=512
LLM_TEMPERATURE=0.4

# --- Embeddings (OpenAI-compatible API) -------------------------------------
# Any provider that speaks the OpenAI /embeddings shape works (OpenAI, Jina,
# VoyageAI OpenAI-compat mode, Ollama, ...). EMBEDDING_DIMS must match the
# vector(n) column in migrations/0001_init.sql.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMS=1536

# --- Cloudflare R2 (optional raw-document mirror, S3-compatible) ------------
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# --- Tuning (safe defaults; usually untouched) ------------------------------
RETRIEVAL_TOP_K=6
RETRIEVAL_KEEP=4
CHUNK_SIZE=800
CHUNK_OVERLAP=150
RATE_WINDOW_SECONDS=60
RATE_MAX_REQUESTS=12
